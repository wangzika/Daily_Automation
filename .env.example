WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_BASE_URL=https://api.weixin.qq.com/cgi-bin
WECHAT_THUMB_MEDIA_ID=
WECHAT_AUTHOR=波波机器人
WECHAT_PUBLISH_MODE=none
WECHAT_COMMENT_OPEN=0
WECHAT_COMMENT_FANS_ONLY=0
WECHAT_BACKEND_URL="https://mp.weixin.qq.com/cgi-bin/appmsg?t=media/appmsg_list&type=10&action=list&lang=zh_CN"

# Email notification after a WeChat draft is created.
EMAIL_NOTIFY_ENABLED=1
EMAIL_NOTIFY_TO=
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
EMAIL_NOTIFY_INCLUDE_QUICK_COMMANDS=1

# Optional email command control. Mail from allowed senders whose subject
# contains EMAIL_COMMAND_SUBJECT_KEYWORD will be processed. The scanner checks
# unread messages plus recent messages, and stores processed fingerprints to
# avoid duplicate runs.
EMAIL_COMMAND_ENABLED=0
EMAIL_COMMAND_IMAP_HOST=imap.qq.com
EMAIL_COMMAND_IMAP_PORT=993
EMAIL_COMMAND_USERNAME=
EMAIL_COMMAND_PASSWORD=
EMAIL_COMMAND_ALLOWED_SENDERS=
EMAIL_COMMAND_SUBJECT_KEYWORD=论文指令
EMAIL_COMMAND_MAX_MESSAGES=100
EMAIL_COMMAND_RECENT_DAYS=7
EMAIL_COMMAND_STATE_PATH=outputs/email_commands/processed_commands.json
EMAIL_COMMAND_DEFAULT_MODE=draft
EMAIL_COMMAND_DEFAULT_TASKS=digest,deepdive
EMAIL_COMMAND_POLL_INTERVAL=300
EMAIL_COMMAND_GIT_PUSH=1

# Daily automation.
AUTOMATION_TIME=09:00
AUTOMATION_PYTHON=
AUTOMATION_WECHAT_MODE=draft
AUTOMATION_DEEPDIVE_MODE=draft
AUTOMATION_LOG_TAIL_LINES=60
TOPIC_ROTATION_ENABLED=on
DEEPDIVE_LIMIT=3
DEEPDIVE_FIGURES=2
DEEPDIVE_PAPER_COVER=1
SEMANTIC_SCHOLAR_ENRICH=off
QUALITY_ENRICH_LIMIT=30
SEMANTIC_SCHOLAR_DELAY_SECONDS=1.0
SEMANTIC_SCHOLAR_API_KEY=
WEEKLY_SUMMARY_ENABLED=1
WEEKLY_SUMMARY_DAY=7
WEEKLY_SUMMARY_DAYS=7
WEEKLY_OUTPUT_DIR=outputs/weekly

# Optional GitHub push. HTTPS and SSH remotes are both supported.
# GITHUB_REPO_URL=https://github.com/your-name/your-repo.git
# GITHUB_REPO_URL=git@github.com:your-name/your-repo.git
GITHUB_REPO_URL=
GITHUB_REPO_SSH=
GITHUB_BRANCH=master
GIT_AUTHOR_NAME="GNSS Paper Bot"
GIT_AUTHOR_EMAIL=

# APP_ID/APP_SECRET are also accepted as aliases for WECHAT_APP_ID/WECHAT_APP_SECRET.
APP_ID=
APP_SECRET=

# Optional tuning.
DIGEST_OUTPUT_DIR=outputs
DIGEST_LIMIT=5
DIGEST_DAYS_BACK=180
DIGEST_PER_TOPIC=10
ARXIV_RETRIES=3
ARXIV_RETRY_DELAY_SECONDS=10.0
ARXIV_MIN_DELAY_SECONDS=3.5
ARXIV_CACHE_DIR=outputs/cache/arxiv
ARXIV_CACHE_TTL_HOURS=26
PAPER_FALLBACK_SOURCES=semantic-scholar,openalex,crossref,existing-json
SEMANTIC_SCHOLAR_SEARCH_LIMIT=25
OPENALEX_SEARCH_LIMIT=25
OPENALEX_DELAY_SECONDS=1.0
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_SEARCH_LIMIT=25
CROSSREF_DELAY_SECONDS=1.0
CROSSREF_MAILTO=
